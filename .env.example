# Copie este arquivo para .env e ajuste se precisar (o .env não vai para o Git).

# Usuário e senha que o docker-compose cria no RabbitMQ. Os serviços em Go
# anteriores usam amqp://ecommerce:ecommerce@localhost:5672/ no código.
# Pagamento e Promoções usam RABBITMQ_URL, configurada abaixo.
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=ecommerce

# Bloco 3: Pagamento, Mock, Promoções e testar-email carregam .env automaticamente.
# Variáveis já exportadas no terminal têm prioridade sobre o arquivo.
RABBITMQ_URL=amqp://ecommerce:ecommerce@localhost:5672/
PAGAMENTO_ADDR=127.0.0.1:8082
PAGAMENTO_WEBHOOK_URL=http://localhost:8082/webhooks/pagamento
MOCK_ADDR=127.0.0.1:8083
MOCK_PUBLIC_URL=http://localhost:8083
MOCK_API_TOKEN=desenvolvimento-local

# API externa de e-mail: chave e remetente autorizado na sua conta Resend.
RESEND_API_KEY=
PROMOCOES_EMAIL_FROM="E-commerce <onboarding@resend.dev>"
# Vetor JSON de strings, usado somente por go run ./cmd/testar-email.
# Adicione outros endereços entre aspas, separados por vírgula dentro do vetor.
PROMOCOES_EMAILS_TESTE='["cliente@example.com"]'
PROMOCOES_INTERESSES_PATH=data/interesses.local.json
# Opcional: duração fixa para a demonstração. Sem ela, varia de 20 a 30 s.
# PROMOCOES_INTERVALO=25s
